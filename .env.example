# ---------- ESPN ----------
# From your team page URL: fantasy.espn.com/football/team?leagueId=XXXX&teamId=Y
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_YEAR=2026
# Private leagues only: copy the espn_s2 and SWID cookies from your browser
# (fantasy.espn.com -> DevTools -> Application -> Cookies). SWID includes the {braces}.
ESPN_S2=
ESPN_SWID=

# ---------- Notifications ----------
# ntfy (free phone push, default) | email | twilio (paid SMS) | sms_gateway | console (print only)
NOTIFY_METHOD=ntfy

# Your private channel name: long and random, since anyone who knows it can read it.
# Subscribe to the same name in the ntfy phone app.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=            # only if you reserve/protect the topic with an ntfy account

# Only if NOTIFY_METHOD=email — Gmail sender + 16-character App Password
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Where alerts go. Leave blank to email yourself (SMTP_USER).
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Only if NOTIFY_METHOD=twilio (also: pip install twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MY_PHONE_NUMBER=
# Only if NOTIFY_METHOD=sms_gateway
SMS_GATEWAY_ADDRESS=

# ---------- Behavior ----------
TIMEZONE=America/Chicago
# No hourly score alerts between these hours (local). Set both equal to disable.
# Injury updates always go out 24/7.
QUIET_HOURS_START=0
QUIET_HOURS_END=9
# How often --loop mode checks
CHECK_EVERY_MIN=10
# true = also send roster/lineup moves on non-game days
ROSTER_ALERTS_EVERY_DAY=false
